{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Existing Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "Open Bot — Runtime, Games and Community",
  "uid": "open-bot-modules",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": ["open-bot", "discord"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Worker telemetry age (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_worker_snapshot_age_seconds",
          "legendFormat": "{{worker}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Operations per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (module, operation, outcome) (rate(open_bot_operations_total[5m]))",
          "legendFormat": "{{module}} / {{operation}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Operation latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, module) (rate(open_bot_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{module}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(open_bot_http_requests_total[5m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tickets by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_tickets",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pending queues",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_disk_queue_items",
          "legendFormat": "{{queue}}"
        },
        {
          "refId": "B",
          "expr": "open_bot_ticket_pending_jobs",
          "legendFormat": "Ticket jobs"
        }
      ]
    },
    {
      "id": 7,
      "title": "Reported errors per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (process) (rate(open_bot_errors_total[5m]))",
          "legendFormat": "{{process}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Mean ticket response / resolution",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(open_bot_ticket_first_response_seconds_total[1h]) / clamp_min(increase(open_bot_ticket_first_responses_total[1h]), 1)",
          "legendFormat": "First response"
        },
        {
          "refId": "B",
          "expr": "increase(open_bot_ticket_resolution_seconds_total[1h]) / clamp_min(increase(open_bot_ticket_closed_total[1h]), 1)",
          "legendFormat": "Resolution"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Modules availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_module_up",
          "legendFormat": "{{worker}} {{module}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Worker resident memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_process_resident_memory_bytes",
          "legendFormat": "{{worker}} {{module}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Worker restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_worker_restarts",
          "legendFormat": "{{worker}} {{module}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Ticket creation and closure rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(open_bot_ticket_created_total[5m]) or rate(open_bot_ticket_closed_total[5m])",
          "legendFormat": "{{worker}} {{module}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "gridPos": {
        "w": 12,
        "x": 0,
        "h": 8,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Module jobs",
      "targets": [
        {
          "expr": "open_bot_module_jobs",
          "refId": "A",
          "legendFormat": "{{kind}} / {{state}}"
        }
      ],
      "id": 13
    },
    {
      "gridPos": {
        "w": 12,
        "x": 12,
        "h": 8,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Moderation cases",
      "targets": [
        {
          "expr": "open_bot_moderation_cases",
          "refId": "A",
          "legendFormat": "{{action}} / {{state}}"
        }
      ],
      "id": 14
    },
    {
      "gridPos": {
        "w": 12,
        "x": 0,
        "h": 8,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Feed deliveries",
      "targets": [
        {
          "expr": "open_bot_feed_delivery",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ],
      "id": 15
    },
    {
      "gridPos": {
        "w": 12,
        "x": 12,
        "h": 8,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Form submissions",
      "targets": [
        {
          "expr": "open_bot_form_submissions",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ],
      "id": 16
    },
    {
      "id": 17,
      "title": "Game server states",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_game_servers",
          "legendFormat": "{{game}} / {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Players online",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_game_players",
          "legendFormat": "{{game}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "title": "Game queries p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, game) (rate(open_bot_game_probe_duration_seconds_bucket[5m])))",
          "legendFormat": "{{game}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Game query failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (game) (rate(open_bot_game_probes_total{outcome=\"error\"}[5m]))",
          "legendFormat": "{{game}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "title": "Game status age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_game_oldest_sample_age_seconds",
          "legendFormat": "{{game}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "title": "Game query last duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_game_query_last_duration_seconds",
          "legendFormat": "{{game}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "title": "Discord Gateway",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "open_bot_gateway_connected{worker=\"bot\"}",
          "legendFormat": "{{worker}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
