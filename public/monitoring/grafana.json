        "x": 12,
        "y": 104,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - open_bot_guild_backup_last_success_timestamp_seconds) and (open_bot_guild_backup_last_success_timestamp_seconds > 0)",
