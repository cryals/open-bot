[Unit]
Description=Open Space Discord Rules Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=open-bot
Group=open-bot
WorkingDirectory=/opt/open-bot
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --enable-source-maps /opt/open-bot/dist/server/src/server/index.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/open-bot/data
UMask=0077

[Install]
WantedBy=multi-user.target
