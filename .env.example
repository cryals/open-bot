BOT_TOKEN=
GUILD_ID=
CLIENT_ID=
CLIENT_SECRET=
PORT=3000
REDIRECT=http://localhost:3000/auth/discord/callback
# Optional: empty means guild owner / roles with Administrator permission until configured in the panel.
ADMIN_ROLE_ID=
HOST=127.0.0.1
DATABASE_PATH=./data/open-bot.sqlite
# Set to true only behind your trusted reverse proxy.
TRUST_PROXY=false
# Error reports: primary bot channel and independent fallback webhook. Optional; never expose the webhook.
LOG_ID=
LOG_WEBHOOK=
# Optional outside Docker. Blank uses the durable local batch queue.
REDIS_URL=
REDIS_KEY_PREFIX=open-bot
# Ticket message content must also be enabled in the Discord Developer Portal.
TICKETS_ENABLED=false
# Explicit hostnames only, comma separated; no schemes, ports or wildcard.
GAME_SERVER_HOSTS=
WATCHDOG_HOSTS=
# Refer to this variable name in Watchdog settings; never put the token in the panel.
WATCHDOG_TOKEN_MAIN=
# Optional dedicated Prometheus exporter; use a random token of 32+ characters.
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_PORT=9091
METRICS_TOKEN=
METRICS_BIND_ADDRESS=127.0.0.1
# Docker Compose options. PORT above is the host port; the container uses 3000.
BIND_ADDRESS=127.0.0.1
MEMORY_LIMIT=1g
# Optional: public hostname for compose.https.yaml, without https:// or a path.
DOMAIN=
# Public wiki base URL at build time. Empty: use GitHub Markdown links.
VITE_DOCS_URL=
